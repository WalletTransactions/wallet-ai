# JWKS google-auth — проверка подписи access-токена.
AUTH_SERVICE_URL=http://127.0.0.1:8080

# LLM — любой сервер с OpenAI API (LM Studio, Ollama /v1, llama-server, vLLM).
# Пусто — ИИ выключен: GET /api/ai/status отвечает enabled=false, сервис работает.
# Из docker-контейнера до LM Studio на хосте: http://host.docker.internal:1234/v1
# (в LM Studio — «Serve on Local Network», см. README.md, «LLM на хосте»).
LLM_URL=http://127.0.0.1:1234/v1
# id из GET {LLM_URL}/models — в LM Studio задаётся `lms load ... --identifier`.
LLM_MODEL=wallet-parse
# Токен API LM Studio (Developer → Server Settings). Пусто — без заголовка.
LLM_API_KEY=
LLM_TIMEOUT_MS=15000
# Как часто проверять, что LLM жива и модель загружена.
LLM_PROBE_INTERVAL_SECS=60

PORT=8087
HOST=127.0.0.1

# Пусто — логи в stdout; иначе папка, файл на день.
# LOG_DIR=logs
# LOG_LEVEL=info
