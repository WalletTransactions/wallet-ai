# JWKS google-auth — проверка подписи access-токена.
AUTH_SERVICE_URL=http://127.0.0.1:8080

# LLM — любой сервер с OpenAI API (LM Studio, Ollama /v1, llama-server, vLLM).
# Пусто — ИИ выключен: GET /api/ai/status отвечает enabled=false, сервис работает.
# Из docker-контейнера до LM Studio на хосте: http://host.docker.internal:1234/v1
# (в LM Studio — «Serve on Local Network», см. README.md, «LLM на хосте»).
LLM_URL=http://127.0.0.1:1234/v1
# id из GET {LLM_URL}/models — в LM Studio задаётся `lms load ... --identifier`.
LLM_MODEL=wallet-parse
# Окно модели — как LMS_CONTEXT в scripts/lms-load.sh.
# LLM_CONTEXT=8192
# Токен API LM Studio (Developer → Server Settings). Пусто — без заголовка.
LLM_API_KEY=
LLM_TIMEOUT_MS=15000
# Как часто проверять, что LLM жива и модель загружена.
LLM_PROBE_INTERVAL_SECS=60

PORT=8087
HOST=127.0.0.1

# Импорт выписок (openspec/changes/add-statement-import). Своя база ai
# (wallet-infra: init-db.sh, migrate.sh ai). Пусто или база не отвечает —
# импорт выключен, трата текстом работает. В compose задаётся из AI_POSTGRES_*.
DATABASE_URL=postgresql://wallet_ai:change-me-ai@127.0.0.1:5432/wallet_ai
# AI_DB_POOL_SIZE=4
# AI_EXTRACT_CHUNK_CHARS=1800
# AI_IMPORTS_MAX_ACTIVE=3
# AI_IMPORT_TTL_DAYS=90
# AI_IMPORT_DONE_TTL_DAYS=7
# AI_IMPORT_PAUSE_MAX_MINS=60
# AI_CLASSIFY_MIN_CONFIDENCE=0.7
# AI_PROFILE_MAX_TOKENS=500
# AI_JOB_TIMEOUT_SECS_EXTRACT_ROWS=180
# AI_JOB_TIMEOUT_SECS_CLASSIFY_ROWS=60
# LLM_MAX_TOKENS_CLASSIFY_ROWS=1024

# Очередь: облачная полоса (Claude) — свои воркеры, GPU не ждёт.
# LLM_MAX_CONCURRENT=1
# AI_CLOUD_MAX_CONCURRENT=2

# Чат (openspec/changes/add-chat-agent). Без WALLET_MCP_URL или
# AUTH_EXCHANGE_SECRET вид chat выключен (503), остальное работает.
# wallet-mcp — напрямую по внутренней сети, не через гейтвей.
WALLET_MCP_URL=
# Секрет actor wallet-ai в TOKEN_EXCHANGE_SECRETS google-auth
# (обмен токена пользователя на токен для wallet-mcp).
AUTH_EXCHANGE_SECRET=
# AI_DEFAULT_PROVIDER=lmstudio
# AI_JOB_TIMEOUT_SECS_CHAT=120
# AI_CHAT_MAX_STEPS=5
# AI_CHAT_HISTORY_TURNS=6
# AI_CHAT_HISTORY_TTL_SECS=1800
# AI_CHAT_TOOL_RESULT_MAX_CHARS=6000
# LLM_MAX_TOKENS_CHAT=1024
# LLM_REASONING_CHAT=none

# Claude: ключ стека и кому он доступен (user_id через запятую или *).
# Пусто — claude недоступен. Данные уходят в Anthropic только после
# согласия пользователя (PUT /api/ai/settings).
ANTHROPIC_API_KEY=
ANTHROPIC_ALLOWED_USERS=
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_MAX_TOKENS=16000
# ANTHROPIC_EFFORT=low
# off — без серверного fallback при отказе модели.
# ANTHROPIC_FALLBACKS=default

# Пусто — логи в stdout; иначе папка, файл на день.
# LOG_DIR=logs
# LOG_LEVEL=info
